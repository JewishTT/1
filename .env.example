# COGNITIVE - environment configuration example
# Copy to .env and adjust per environment.

## Core
COGNITIVE_ENV=dev

## PostgreSQL (operational state)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cognitive
POSTGRES_USER=cognitive
POSTGRES_PASSWORD=cognitive

## Redis (frontier leases/cooldowns)
REDIS_URL=redis://localhost:6379/0

## Kafka (KRaft) + Schema Registry
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

## S3 / MinIO (raw evidence, content-addressed)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=demo
S3_SECRET_KEY=demopass
S3_BUCKET_RAW=knowledge

## OpenSearch (search projection)
OPENSEARCH_URL=http://localhost:9200

## ClickHouse (analytics projection)
CLICKHOUSE_URL=http://localhost:8123

## Neo4j (graph dev backend)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cognitive

## Temporal (workflows)
TEMPORAL_HOST=localhost:7233

## API
COGNITIVE_API_HOST=0.0.0.0
COGNITIVE_API_PORT=8000

## Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

## Secrets (never hardcode in domain logic)
VAULT_ADDR=http://localhost:8200