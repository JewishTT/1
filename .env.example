# COGNITIVE - environment configuration example
# Copy to .env and adjust per environment.

## Core
COGNITIVE_ENV=dev

## PostgreSQL (operational state)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cognitive
POSTGRES_USER=cognitive
POSTGRES_PASSWORD=cognitive

## Redis (frontier leases/cooldowns)
REDIS_URL=redis://localhost:6379/0

## Transport (Feature 024 / D1=a)
## Redpanda is the single dev/live transport runtime, Kafka-compatible protocol.
## Broker 19092, schema registry 18081 (compose profile `core`).
## Confluent Kafka remains available under the `legacy-kafka` profile for comparison;
## to use it, start that profile and override these two values to :9092 / :8081.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:18081

## S3 / MinIO (raw evidence, content-addressed)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=demo
S3_SECRET_KEY=demopass
S3_RAW_BUCKET=knowledge

## Optional Tenzir Node (Layer-1 derived structural normalization; disabled by default)
## Local development: docker compose --profile tenzir up -d tenzir-node
## The compose service runs unauthenticated developer mode bound to host loopback only.
## Production: configure HTTPS and a token; do not use developer mode off-loopback.
TENZIR_ENABLED=false
TENZIR_NODE_URL=http://localhost:5160
TENZIR_NODE_TOKEN=
TENZIR_NODE_VERSION=6.19.1
TENZIR_TIMEOUT_SECONDS=45
TENZIR_MAX_BATCH_RECORDS=256
TENZIR_MAX_REQUEST_BYTES=2000000
TENZIR_MAX_RESPONSE_BYTES=4000000
TENZIR_MAX_OUTPUT_RECORDS=4096
TENZIR_ALLOW_INSECURE_HTTP=false

## Feature 034 public metadata pilot
# Needed only when the approved source scope includes Crossref. Use a real monitored
# operator contact address; acquisition refuses to send Crossref requests without it.
# COGNITIVE_CROSSREF_MAILTO=your-real-operator-contact@example.org

## OpenSearch (search projection)
OPENSEARCH_URL=http://localhost:9200

## ClickHouse (analytics projection)
CLICKHOUSE_URL=http://localhost:8123

## Neo4j (graph dev backend)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cognitive

## Temporal (workflows)
TEMPORAL_HOST=localhost:7233

## Control-plane authentication (JWT by default; fail closed)
# Configure a random secret of at least 32 bytes and the exact issuer/audience from your IdP.
# COGNITIVE_AUTH_MODE=jwt
# COGNITIVE_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# COGNITIVE_JWT_ISSUER=https://your-identity-provider.example
# COGNITIVE_JWT_AUDIENCE=cognitive-control-plane
# Local development only; never enable these in a deployed environment:
# COGNITIVE_AUTH_MODE=development
# COGNITIVE_AUTH_ALLOW_DEV_HEADERS=true

## API
COGNITIVE_API_HOST=0.0.0.0
COGNITIVE_API_PORT=8000

## Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

## Secrets (never hardcode in domain logic)
VAULT_ADDR=http://localhost:8200