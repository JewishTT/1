{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RedTeamOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "criticisms",
    "alternatives",
    "missing_evidence",
    "obligation_candidates"
  ],
  "properties": {
    "criticisms": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "issue",
          "severity"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "explanation",
          "claim_refs"
        ],
        "properties": {
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "claim_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50
          }
        }
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      },
      "maxItems": 50
    },
    "obligation_candidates": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "reason"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}