{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RedTeamInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_refs",
    "claims",
    "source_lineage",
    "temporal_refs"
  ],
  "properties": {
    "finding_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "claims": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "state",
          "evidence_refs"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "proposed",
              "admitted",
              "contested",
              "retracted",
              "superseded"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50
          }
        }
      }
    },
    "source_lineage": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "root_family"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "root_family": {
            "type": "string"
          }
        }
      }
    },
    "temporal_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 100
    }
  }
}